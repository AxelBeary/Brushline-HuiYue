# ============================================
# Artist Commission Platform - 环境配置
# 复制此文件为 .env 并修改
# ============================================

# 主域名（不带协议头）
DOMAIN=artgroup.com

# 服务端口
PORT=3000

# 上传文件存储路径
UPLOAD_DIR=./uploads

# 数据库文件路径
DB_PATH=./data/commission.db

# QQ Bot 配置（Phase 2，暂时留空即可）
BOT_WS_URL=
BOT_ENABLED=false

# 管理员 QQ 号（用于初始化管理员账号）
ADMIN_QQ=10000

# 会话签名密钥（生产环境必须改为随机长字符串！）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# 登录码有效期（秒）
LOGIN_CODE_TTL=300

# 登录码最大尝试次数
LOGIN_CODE_MAX_ATTEMPTS=3

# CORS 允许的来源（生产环境，逗号分隔，留空则禁止跨域）
CORS_ORIGIN=

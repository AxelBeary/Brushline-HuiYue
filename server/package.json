{
  "name": "artist-commission-server",
  "version": "0.11.0",
  "description": "画师约稿管理平台 - 后端服务",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint . && oxlint src tests",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "db:init": "node src/db/init.js",
    "db:seed": "tsx src/db/seed.ts",
    "totp:rebind": "tsx scripts/totp-rebind.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.2",
    "@sentry/node": "^10.69.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "nanoid": "^5.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "oxlint": "^1.77.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true
  }
}
